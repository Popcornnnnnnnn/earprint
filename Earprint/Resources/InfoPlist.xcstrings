{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earprint reads your headphone audio levels from Apple Health to show how long and how loudly you listen. Data stays on your iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earprint 仅以只读方式读取 Apple“健康”中的耳机音量数据，用于展示你的聆听时长与音量分布。所有数据均保留在你的 iPhone 本地。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earprint reads your headphone audio levels from Apple Health to build your listening archive and never writes data to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earprint 仅以只读方式读取 Apple“健康”中的耳机音量数据以生成你的聆听档案，不会向 Apple“健康”写入数据。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
